# ============================================================================
#  ENVIRONMENT TEMPLATE — safe to commit.
#  Copy this file to `.env` (which is gitignored) and fill in real values.
#  docker-compose reads `.env` automatically. Everything here has a working
#  local default, so the app runs WITHOUT this file — you only need it to
#  override defaults or enable the optional Adzuna job source.
# ============================================================================

# --- Database (local-dev defaults are fine; change for anything real) --------
DB_USERNAME=postgres
DB_PASSWORD=postgres

# --- Auth --------------------------------------------------------------------
# MUST be replaced with a long random string for any non-local deployment.
JWT_SECRET=change-me-to-a-long-random-secret-at-least-256-bits
JWT_EXPIRATION_MS=86400000

# --- Adzuna job aggregator (OPTIONAL) ----------------------------------------
# The app runs fine without these — the Adzuna source just stays off.
# Get your OWN free key (no card) at https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
