# Database — points at the centralized Postgres (see repo-root docker-compose.yml).
# Start the central DB once with:  docker compose up -d   (from the portfolio root)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=jobtracker
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Auth
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRATION_MS=86400000

# Adzuna job-search API (get keys at https://developer.adzuna.com)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
