# ============================================================================
#  TEMPLATE — safe to commit.  Copy this file to `secrets.properties`
#  (same folder) and fill in your real values. `secrets.properties` is
#  gitignored, so your real keys never get pushed to a public repo.
# ============================================================================

# Adzuna job aggregator — get a free key at https://developer.adzuna.com/
ADZUNA_APP_ID=your-adzuna-app-id
ADZUNA_APP_KEY=your-adzuna-app-key

# You can move other secrets here too and reference them from application.yml,
# e.g. JWT_SECRET=... or DB_PASSWORD=...
